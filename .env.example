# Firebase web config (Console -> Project settings -> Your apps -> SDK config)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Store identity inside the shared Firestore. Every document this deployment
# reads or writes lives under stores/{VITE_STORE_ID}/. Use a slug, one per
# storefront: leapsmart, techma, ...
# Seed a new one with: npm run store:create -- <storeId> "<name>" [adminUid]
VITE_STORE_ID=your-store-slug

# ---------------------------------------------------------------------------
# Cloud Functions env (set in functions/.env, NOT here). Used by the Resend
# owner-notification that fires when an Emkan "request to pay" order is placed:
#   RESEND_API_KEY=re_xxx            # Resend API key
#   OWNER_EMAIL=owner@example.com    # recipient of the order notification
#   RESEND_FROM_EMAIL=orders@yourdomain.com  # verified Resend sender
# ---------------------------------------------------------------------------
