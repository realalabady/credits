# Cloud Functions runtime env. Copy to functions/.env and fill in.
# Firebase CLI loads functions/.env into process.env for deploy & emulators.
# Used by the Resend owner notification that fires when an Emkan order is placed.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Store owner's email — receives the "new Emkan order, awaiting payment" notice
OWNER_EMAIL=

# Verified Resend sender. Defaults to onboarding@resend.dev if left blank
# (fine for testing; use your verified domain in production).
RESEND_FROM_EMAIL=

# --- PayPal (card checkout) -------------------------------------------------
# From https://developer.paypal.com/dashboard/applications -> Apps & Credentials.
# The SECRET must only ever live here (server side), never in the web .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test cards) or live (real money). Defaults to sandbox.
PAYPAL_MODE=sandbox

# Brand name + base URL used in the PayPal checkout window and return links.
STORE_BRAND=
STORE_BASE_URL=
